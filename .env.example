# Copy to .env in the project root and configure a LiteLLM model/provider.
DEVPILOT_MODEL_NAME=openai/your-model
OPENAI_API_KEY=
# Set the matching provider key for your model, for example ANTHROPIC_API_KEY.

# DevPilot binds to localhost by default; do not expose this approval API publicly.
DEVPILOT_HOST=127.0.0.1
DEVPILOT_PORT=8000
# Optional execution limits.
DEVPILOT_AGENT_MAX_ITERATIONS=30
DEVPILOT_COMMAND_TIMEOUT=60
DEVPILOT_MODEL_TIMEOUT=120
